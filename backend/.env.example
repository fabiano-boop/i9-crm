# === BANCO DE DADOS ===
DATABASE_URL=postgresql://i9user:i9pass@localhost:5432/i9crm

# === REDIS ===
REDIS_URL=redis://localhost:6379

# === JWT ===
JWT_SECRET=your-jwt-secret-here-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-here-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# JWT de curta duração usado no passo intermediário do login com 2FA (5 min fixo)
# Reutiliza JWT_SECRET — sem variável adicional necessária

# === ANTHROPIC / CLAUDE ===
ANTHROPIC_API_KEY=your-anthropic-key-here

# === GOOGLE SHEETS ===
GOOGLE_SHEETS_ID=your-google-sheet-id-here
# JSON completo da service account (minificado em uma linha)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# === META CLOUD API (WhatsApp Business — oficial) ===
# Obter em: Meta for Developers > WhatsApp > API Setup
WHATSAPP_PHONE_ID=           # Phone Number ID (ex: 1086372051225190)
WHATSAPP_WABA_ID=            # WhatsApp Business Account ID
WHATSAPP_TOKEN=              # System User Access Token (permanente)
WHATSAPP_VERIFY_TOKEN=i9crm_webhook_2026  # Token para verificação do webhook
BACKEND_URL=https://i9-crm-production.up.railway.app

# === EMAIL (Resend) ===
RESEND_API_KEY=your-resend-key-here
EMAIL_FROM=crm@i9solucoes.com.br
EMAIL_FROM_NAME=i9 Soluções Digitais

# === EMAIL FALLBACK (SMTP/Nodemailer) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# === BACKUP ===
# URL direta ao banco (sem pooler) — necessária para pg_dump no Supabase
DIRECT_URL=postgresql://i9user:i9pass@db.xxxxx.supabase.co:5432/postgres
# ID da pasta no Google Drive onde os backups serão armazenados
BACKUP_GOOGLE_DRIVE_FOLDER_ID=
# Dias de retenção dos backups no Drive (padrão: 30)
BACKUP_RETENTION_DAYS=30
# Email do admin que recebe alertas de falha no backup
ADMIN_EMAIL=admin@i9solucoes.com.br

# === TRACKING ===
TRACKING_BASE_URL=http://localhost:3001
TRACKING_SECRET=your-tracking-hmac-secret-here-min-32-chars

# === SERVIDOR ===
PORT=3000
TRACKING_PORT=3001
NODE_ENV=development

# === FRONTEND ===
FRONTEND_URL=http://localhost:5173

# === LOGS ===
LOG_LEVEL=info

# === AGENTE IA (WhatsApp) ===
WHATSAPP_AGENT_ENABLED=false  # true = Maya responde leads automaticamente

# === RELATÓRIOS SEMANAIS ===
# URL base do backend para gerar links do PDF no WhatsApp
REPORTS_BASE_URL=https://seu-backend.railway.app
# Caminho do executável do Chromium para geração de PDF via Puppeteer (opcional)
# Em produção no Railway, deixe vazio para usar o Chromium baixado pelo puppeteer
PUPPETEER_EXECUTABLE_PATH=

# === META ADS (Marketing API) ===
# Obter em: Meta for Developers > Marketing API > Access Tokens
META_PAGE_ACCESS_TOKEN=      # Page Access Token (permanente, gerado via System User)
AD_ACCOUNT_ID=2597262793871475  # ID da conta de anúncios (sem o prefixo "act_")

# === GOOGLE ANALYTICS 4 + SEARCH CONSOLE (SPRINT 3.6) ===
# OAuth2 credentials do Google Cloud Console (mesmo projeto do Calendar se existir)
GA4_CLIENT_ID=               # OAuth Client ID
GA4_CLIENT_SECRET=           # OAuth Client Secret
GA4_REDIRECT_URI=https://i9-crm-production.up.railway.app/api/integrations/ga4/callback
SEARCH_CONSOLE_REDIRECT_URI=https://i9-crm-production.up.railway.app/api/integrations/search-console/callback

# === GA4 DA AGÊNCIA (site próprio da i9) ===
# Property ID fixo do Google Analytics da agência
GA4_AGENCY_PROPERTY_ID=534760423
# Redirect URI para o flow OAuth da agência (pode ser o mesmo projeto OAuth acima)
GA4_AGENCY_REDIRECT_URI=https://i9-crm-production.up.railway.app/api/integrations/ga4/agency-callback
# Tokens ficam no banco (campo ga4AgencyRefreshToken na tabela User, admin).
# Para conectar: acesse GET /api/integrations/ga4/agency-auth e abra a URL retornada.
